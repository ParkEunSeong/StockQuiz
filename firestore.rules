rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Existing stocknews data access is preserved.
    match /users/{userId}/{document=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    function isRankOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function validRank() {
      return request.resource.data.keys().hasAll(['nickname', 'points', 'correct', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['nickname', 'points', 'correct', 'updatedAt'])
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() > 0
        && request.resource.data.nickname.size() <= 24
        && request.resource.data.points is int
        && request.resource.data.points >= 0
        && request.resource.data.points <= 1000000
        && request.resource.data.correct is int
        && request.resource.data.correct >= 0
        && request.resource.data.correct <= 50000
        && request.resource.data.points == request.resource.data.correct * 20
        && request.resource.data.updatedAt == request.time;
    }

    function doesNotDecrease() {
      return request.resource.data.points >= resource.data.points
        && request.resource.data.correct >= resource.data.correct;
    }

    match /stockQuizAllRanks/{userId} {
      allow read: if true;
      allow create: if isRankOwner(userId) && validRank();
      allow update: if isRankOwner(userId) && validRank() && doesNotDecrease();
      allow delete: if false;
    }

    match /stockQuizWeeklyRanks/{weekKey}/users/{userId} {
      allow read: if true;
      allow create: if isRankOwner(userId) && validRank();
      allow update: if isRankOwner(userId) && validRank() && doesNotDecrease();
      allow delete: if false;
    }
  }
}
